{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "rasel-mobile-zoon",
  "main": "src/worker.js",
  "compatibility_date": "2026-11-19",
  "assets": {
    "directory": "./public",
    "binding": "ASSETS",
    "run_worker_first": true
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "rasel-mobile-zoon-db",
      "database_id": "ee57692b-0f9d-4088-b302-b58a48b694ec"
    }
  ],
  "r2_buckets": [
    {
      "binding": "IMAGES",
      "bucket_name": "rasel-mobile-zoon-images"
    }
  ]
}
